<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="twist worker" Width="330" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" Background="#111114" Foreground="#EDEDF1" FontFamily="Segoe UI" FontSize="11">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDEDF1"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#D4CEDF"/><Setter Property="Background" Value="#24232C"/><Setter Property="BorderBrush" Value="#36343F"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#1D1D23"/><Setter Property="Foreground" Value="#D6D2DF"/><Setter Property="BorderBrush" Value="#35333C"/><Setter Property="Padding" Value="7"/><Setter Property="CaretBrush" Value="#BEAAF3"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#202025"/><Setter Property="Foreground" Value="#EDEDF1"/><Setter Property="Padding" Value="10,8"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#33313D"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#EDEDF1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Background="#202025" BorderThickness="0" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#202025" CornerRadius="7" BorderBrush="#303037" BorderThickness="1"><Grid><TextBlock Text="⌄" Foreground="#9797A4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,2"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="12,5,32,5" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#202025" CornerRadius="7" BorderBrush="#36363E" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" Margin="0,5,0,0"><ScrollViewer MaxHeight="250"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" HorizontalContentAlignment="Left" Foreground="{TemplateBinding Foreground}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path x:Name="Chevron" Data="M0,0 L4,4 L8,0" Stroke="#8D8D99" StrokeThickness="1.4" Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5"/><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#111114" BorderBrush="#34313E" BorderThickness="1" CornerRadius="10" Padding="14,10,14,12"><StackPanel>
  <Grid x:Name="MiniTitle" Background="Transparent" Height="25"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="29"/><ColumnDefinition Width="29"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M 0,5 C 18,-6 4,27 22,16 M 0,16 C 18,27 4,-6 22,5" Stroke="#BEAAF3" StrokeThickness="2.2" Width="19" Height="20" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="twist" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="worker" Foreground="#777582" Margin="8,3,0,0"/></StackPanel><Button x:Name="MiniMinimize" Grid.Column="1" Content="−" BorderBrush="Transparent" Background="Transparent" Padding="4"/><Button x:Name="MiniClose" Grid.Column="2" Content="×" BorderBrush="Transparent" Background="Transparent" Padding="4"/></Grid>
  <ComboBox x:Name="MiniAccounts" Height="30" Margin="0,6,0,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Account}" FontSize="11"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
  <Grid Margin="1,0,0,8"><StackPanel Orientation="Horizontal"><Ellipse x:Name="MiniDot" Width="5" Height="5" Fill="#777582" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="MiniStatus" Text="Waiting for controller" Foreground="#BDB4CE" MaxWidth="180" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock x:Name="MiniPoint" Text="not set" HorizontalAlignment="Right" Foreground="#A992D4" FontSize="10"/></Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions><Button x:Name="MiniCapture" Content="Select cursor point" Background="#BEAAF3" Foreground="#231B32" BorderBrush="#BEAAF3" Margin="0,0,8,0"/><Button x:Name="MiniStop" Grid.Column="1" Content="Stop"/></Grid>
  <TextBlock x:Name="MiniHint" Text="Keep Roblox in front. Control fishing from the main UI." Foreground="#74707E" FontSize="9" Margin="0" Visibility="Collapsed" TextWrapping="Wrap"/>
  <Expander Header="UI alignment" Foreground="#777280" FontSize="10" Margin="0,7,0,0"><StackPanel Margin="0,8,0,0"><TextBlock Text="With the rod equipped, click Align then right-click the center of the highest bait row." Foreground="#A49BAC" FontSize="10" TextWrapping="Wrap"/><TextBlock x:Name="MiniAlignValue" Text="UI offset: 0, 0 px" Foreground="#BEAAF3" Margin="0,5,0,5" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions><Button x:Name="MiniAlign" Content="Align bait / purchase UI" Padding="8,5" Margin="0,0,8,0"/><Button x:Name="MiniResetAlign" Grid.Column="1" Content="Reset" Padding="8,5"/></Grid></StackPanel></Expander>
  <Expander x:Name="MiniPair" Header="Manual pairing" Foreground="#777280" FontSize="10" Margin="0,7,0,0"><StackPanel Margin="0,8,0,0"><TextBox x:Name="MiniCode" ToolTip="Pairing code from the controller" FontSize="9"/><Button x:Name="MiniConnect" Content="Connect" Margin="0,6,0,0" Padding="8,5"/></StackPanel></Expander>
 </StackPanel></Border>
</Window>