    </StackPanel>
    <Border Background="#1A1920" CornerRadius="8" Padding="14,12" Margin="0,22,0,22"><TextBlock x:Name="AlertsStatus" Text="Notifications are off." Foreground="#C6B9E0" FontSize="12" TextWrapping="Wrap"/></Border>
    <TextBlock Text="Message preview" FontSize="11" Foreground="#94949E"/><Border Style="{StaticResource Panel}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Hie was stored successfully" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Account  ·  @your_account&#10;Rarity  ·  Legendary&#10;Fish caught  ·  147&#10;Fishing time  ·  01:23:45&#10;Bait remaining  ·  Common 79 · Rare 5 · Legendary 0" Foreground="#A69CAF" FontSize="12" Margin="0,13,0,0" LineHeight="24"/></StackPanel></Border>
