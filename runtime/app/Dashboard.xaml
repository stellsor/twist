    </StackPanel></Border>
    <Border x:Name="WorkerPanel" Style="{StaticResource Panel}" Visibility="Collapsed" Margin="0,0,0,18"><StackPanel>
     <TextBlock Text="Pair with your main desktop" FontWeight="SemiBold"/><TextBlock Text="The controller and RDP sessions must run on this same Windows computer." Foreground="#85858F" FontSize="11" Margin="0,8,0,12"/>
