    <Expander Header="Tools" Foreground="#9999A5" Margin="0,25,0,20"><StackPanel Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="Observe" Content="Observe" Style="{StaticResource Quiet}"/><Button x:Name="AttachAll" Content="Attach all" Style="{StaticResource Quiet}"/><Button x:Name="Diagnose" Content="Inspect" Style="{StaticResource Quiet}"/><Button x:Name="OpenLogs" Content="Logs" Style="{StaticResource Quiet}"/><Button x:Name="OpenFolder" Content="Profiles" Style="{StaticResource Quiet}"/></StackPanel></StackPanel></Expander>
