nel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="WorldEmpty" Text="No fruit spawn announcement has been captured yet. An All Seeing Eye is required for pulse alerts." Foreground="#8A8396" Margin="0,10,0,0" TextWrapping="Wrap"/><Expander x:Name="WorldHistoryExpander" Header="Spawn history" Foreground="#B9A9D7" Margin="0,24,0,0"><StackPanel Margin="0,15,0,0"><TextBlock x:Name="WorldHistoryCount" Foreground="#8E879A" FontSize="11" Margin="0,0,0,12"/><ItemsControl x:Name="WorldHistoryRows"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Panel}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Time}" Foreground="#8A8297" FontSize="10" Margin="0,0,0,8"/><TextBlock Text="{Binding Announcement}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Coordinates}" FontFamily="Consolas" Foreground="#D3C2F5" FontSize="16" Margin="0,10,0,8"/><TextBlock Text="{Binding Detail}" Foreground="#898292" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="WorldHistoryEmpty" Text="Spawn announcements captured while you are AFK will be saved here." Foreground="#8A8396" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander></StackPanel></ScrollViewer>

   <ScrollViewer x:Name="AlertsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="650" Width="640" HorizontalAlignment="Left" Margin="0,14,0,20">
