   </StackPanel></ScrollViewer>

   <Grid x:Name="SettingsHubView" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBlock Text="Settings" FontSize="23" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><Button x:Name="SettingsGeneralTab" Content="General" Style="{StaticResource Quiet}" Margin="0,0,8,0"/><Button x:Name="NavConnections" Content="Connections" Style="{StaticResource Quiet}" Margin="0,0,8,0"/><Button x:Name="NavActivity" Content="Activity" Style="{StaticResource Quiet}"/></StackPanel></StackPanel>
   <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="650" HorizontalAlignment="Left" Width="640"><TextBlock x:Name="ProfileTitle" Text="Select an account to configure fishing." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,7"/><TextBlock Text="Changes save automatically. Fishing settings apply on the next start." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,24"/>
