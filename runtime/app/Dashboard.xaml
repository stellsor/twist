="FruitStatus" Foreground="#B6A2DB" FontSize="11" Margin="0,8,0,24"/><TextBlock Text="Session limits" FontWeight="SemiBold"/><TextBlock Text="Finishes the current round before stopping. Zero means unlimited." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,13"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Stop after full rounds" FontSize="11" Foreground="#A1A1AD"/><TextBox x:Name="RoundGoal" Text="0" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="Time limit · minutes" FontSize="11" Foreground="#A1A1AD"/><TextBox x:Name="TimeLimit" Text="0" Margin="0,7,0,0"/></StackPanel></Grid>
