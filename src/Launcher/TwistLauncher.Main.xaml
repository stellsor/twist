<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="twist launcher" Width="420" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#111114" Foreground="#EDEDF1" FontFamily="Segoe UI" FontSize="12">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDEDF1"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#231B32"/><Setter Property="Background" Value="#BEAAF3"/><Setter Property="BorderBrush" Value="#BEAAF3"/><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value=".85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Background="#1B1B21" BorderBrush="#303038" BorderThickness="1" CornerRadius="8" Padding="14,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><ContentPresenter/><Border x:Name="Ring" Grid.Column="1" Width="14" Height="14" CornerRadius="7" BorderThickness="1" BorderBrush="#625C70" VerticalAlignment="Center"><Ellipse x:Name="Dot" Fill="#BEAAF3" Margin="3" Visibility="Collapsed"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#BEAAF3"/><Setter TargetName="Card" Property="Background" Value="#25212E"/><Setter TargetName="Ring" Property="BorderBrush" Value="#BEAAF3"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Opacity" Value=".86"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#111114" BorderBrush="#34313E" BorderThickness="1" CornerRadius="12" Padding="22,17,22,20"><StackPanel>
  <Grid x:Name="TitleBar" Background="Transparent" Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M 0,5 C 18,-6 4,27 22,16 M 0,16 C 18,27 4,-6 22,5" Stroke="#BEAAF3" StrokeThickness="2.3" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"/><TextBlock Text="twist" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="0.7.29" FontSize="10" Foreground="#8D859A" Margin="9,11,0,0"/></StackPanel><Button x:Name="CloseButton" Grid.Column="1" Content="×" Background="Transparent" Foreground="#8E8798" BorderBrush="Transparent" Padding="3" VerticalAlignment="Top"/></Grid>
  <TextBlock Text="Choose how to open twist" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Your saved settings are ready in every mode." Foreground="#8D8797" FontSize="11" Margin="0,5,0,17"/>
  <RadioButton x:Name="WorkerChoice" GroupName="Mode"><StackPanel><TextBlock Text="Worker" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Compact panel for this RDP session." Foreground="#9C95A7" FontSize="11" Margin="0,4,0,0"/></StackPanel></RadioButton>
  <RadioButton x:Name="ControllerChoice" GroupName="Mode"><StackPanel><TextBlock Text="Controller" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Manage accounts and connected workers." Foreground="#9C95A7" FontSize="11" Margin="0,4,0,0"/></StackPanel></RadioButton>
  <RadioButton x:Name="LocalChoice" GroupName="Mode"><StackPanel><TextBlock Text="Local" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Fish directly on this Windows desktop." Foreground="#9C95A7" FontSize="11" Margin="0,4,0,0"/></StackPanel></RadioButton>
  <CheckBox x:Name="AdminChoice" Content="Run controller as administrator" Foreground="#B6ADCA" IsChecked="True" Margin="2,2,0,10" Visibility="Collapsed" ToolTip="Helps discover workers running as other Windows users."/>
  <TextBlock x:Name="Status" Foreground="#C9AFB8" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed" Margin="1,1,0,10"/>
  <TextBlock x:Name="UpdateStatus" Text="Checking offsets when opened…" Foreground="#8D8797" TextWrapping="Wrap" FontSize="10" Margin="1,2,0,8"/>
  <Button x:Name="LaunchButton" Content="Open worker" FontWeight="SemiBold" Margin="0,5,0,0"/>
  <Border BorderBrush="#2E2A37" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0"><StackPanel><TextBlock x:Name="AppUpdateStatus" Text="Checking for app updates…" Foreground="#9D95AB" TextWrapping="Wrap" FontSize="11"/><Button x:Name="DownloadUpdate" Content="Download update" Visibility="Collapsed" Margin="0,9,0,0" Padding="10,8"/></StackPanel></Border>
 </StackPanel></Border>
</Window>